# ============================================================
# DRC Government Digital Assistant — Environment Variables
# Copy this file to .env and fill in your values.
# No Docker required — the app works with SQLite + InMemory layers.
# ============================================================

DJANGO_SECRET_KEY=replace-with-a-random-secret-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# ── Database ───────────────────────────────────────────────
# Leave unset to auto-detect (SQLite if no Postgres, Postgres if reachable).
# Set DB_ENGINE=sqlite to force SQLite even if Postgres is running.
DB_ENGINE=sqlite

# ── LLM Provider ───────────────────────────────────────────
# auto → Ollama when DEBUG=True, Gemini when DEBUG=False
# Set LLM_PROVIDER=gemini and add GEMINI_API_KEY to use Gemini everywhere.
LLM_PROVIDER=auto
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT=120

# ── Ollama (local LLM — optional, only needed for local dev) ─
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_LINGALA_MODEL=
OLLAMA_KEEP_ALIVE=24h
OLLAMA_REQUEST_TIMEOUT=300

# ── Web search (optional) ──────────────────────────────────
TAVILY_API_KEY=
NGROK_AUTHTOKEN=

# ── Embeddings ─────────────────────────────────────────────
# Set to True only if the model is not yet cached locally.
EMBEDDING_ALLOW_DOWNLOAD=False
EMBEDDING_MODEL_NAME=BAAI/bge-m3

# ── Voice / Speech-to-Text (CPU-safe defaults) ─────────────
# WHISPER_DEVICE=cuda and WHISPER_COMPUTE=float16 if you have a GPU.
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE=int8
