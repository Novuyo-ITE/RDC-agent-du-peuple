DJANGO_SECRET_KEY=replace-with-a-random-secret
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
DB_ENGINE=sqlite

# auto selects Ollama with DEBUG=True and Gemini with DEBUG=False.
# Set gemini explicitly to test Gemini locally, then restore auto.
LLM_PROVIDER=auto
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT=120

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_LINGALA_MODEL=
OLLAMA_KEEP_ALIVE=24h
OLLAMA_REQUEST_TIMEOUT=300

TAVILY_API_KEY=
EMBEDDING_ALLOW_DOWNLOAD=False
WHISPER_DEVICE=cpu
WHISPER_COMPUTE=int8
